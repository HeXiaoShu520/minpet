# MINIPET App settings
APP_VOLUME=0.4    # 音量设置，范围 0.0-1.0，默认 0.4
APP_SCALE=1.0     # 宠物大小比例，建议 0.2-5.0，默认 1.0

# MINIPET LLM settings
# Only OpenAI-compatible Chat Completions API is supported.
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_SYSTEM_PROMPT=你是一只可爱的桌面宠物，性格活泼亲切，会用简短、口语化、带点撒娇的语气陪伴主人聊天。

# MINIPET TTS settings
TTS_ENABLED=false
TTS_API_KEY=
TTS_VOICE_NAME=zh_female_vv_uranus_bigtts
TTS_MAX_CHARS=200

# MINIPET Realtime settings
# Realtime uses the same TTS_API_KEY above.
REALTIME_ENABLED=false
REALTIME_MODEL=1.2.1.1
REALTIME_SPEAKER=zh_female_vv_jupiter_bigtts
REALTIME_BOT_NAME=miniPet
REALTIME_SYSTEM_ROLE=你是一只可爱的桌面宠物，陪伴用户聊天，回答要简短自然。
REALTIME_SPEAKING_STYLE=语气活泼、亲切、口语化。
