# MiniPet App settings
APP_VOLUME=0.4    # 音量设置，范围 0.0-1.0，默认 0.4
APP_SCALE=1.0     # 宠物大小比例，建议 0.2-5.0，默认 1.0

# MiniPet LLM settings
# Only OpenAI-compatible Chat Completions API is supported.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MEMORY_TURNS=10
LLM_SYSTEM_PROMPT=你是一只可爱的桌面宠物，性格活泼亲切，会用简短、口语化、带点撒娇的语气陪伴主人聊天。

# MiniPet OpenClaw settings
OPENCLAW_API_URL=http://127.0.0.1:18789/v1/responses
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=openclaw:main
OPENCLAW_USER=minipet_user
OPENCLAW_TIMEOUT=120

# MiniPet TTS settings
TTS_ENABLED=false
TTS_API_KEY=
TTS_VOICE_NAME=zh_female_vv_uranus_bigtts
TTS_MAX_CHARS=200

# MiniPet DoubaoCall settings
# DoubaoCall uses the same TTS_API_KEY above.
DOUBAO_CALL_SPEAKER=zh_female_vv_jupiter_bigtts
